# Database connection (Neon Postgres)
# These will be injected automatically when connected to Vercel with the Neon integration
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/database?sslmode=require

# API key for post ingestion and admin approval endpoints
# Generate a secure random string for production
INGEST_API_KEY=your-secure-api-key-here

# Optional: Set to 'production' to skip sample posts during seeding
NODE_ENV=development
